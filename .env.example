# ============================================================================
# Tirapro — biến môi trường (single source of truth). Copy sang .env để chạy.
# Mọi biến mới PHẢI được thêm vào file này.
# ============================================================================

# ---------- Node ----------
NODE_ENV=development

# ---------- PostgreSQL (image: pgvector/pgvector:pg16) ----------
# Giữ user/db/mật khẩu `projira` để không phá .env đang có (chỉ tên container đã đổi thành tirapro-*).
POSTGRES_USER=projira
POSTGRES_PASSWORD=projira
POSTGRES_DB=projira
POSTGRES_PORT=5432
DATABASE_URL="postgresql://projira:projira@localhost:5432/projira?schema=public&connection_limit=10&pool_timeout=20"
# DIRECT_URL: kết nối trực tiếp (bypass PgBouncer) cho prisma migrate. Dev = trùng DATABASE_URL.
DIRECT_URL="postgresql://projira:projira@localhost:5432/projira?schema=public"

# ---------- Redis (socket.io adapter + cache + presence + throttle) ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL="redis://localhost:6379"

# ---------- Adminer ----------
ADMINER_PORT=8080

# ---------- API (NestJS) ----------
API_PORT=4000
API_HOST=0.0.0.0
API_GLOBAL_PREFIX=api
API_VERSION=v1
CORS_ORIGIN=http://localhost:5173

# ---------- Auth (JWT access + refresh rotation) ----------
JWT_ACCESS_SECRET=dev_access_secret_change_me_min_32_chars_long_0001
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_min_32_chars_long_002
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ---------- Realtime (Socket.io) ----------
WS_PATH=/realtime
WS_USE_REDIS_ADAPTER=true

# ---------- Storage (Attachments, ảnh đại diện, tệp import, cờ hệ thống) ----------
# local = ghi xuống STORAGE_LOCAL_DIR (mặc định). s3 = S3/MinIO: BẮT BUỘC đủ S3_ENDPOINT, S3_BUCKET, S3_ACCESS_KEY, S3_SECRET_KEY
# (thiếu là API không khởi động, báo rõ biến nào). Khoá object giống đường dẫn local ⇒ chuyển local → S3 chỉ là sao chép:
#   pnpm --filter @tirapro/api run storage:migrate-local-to-s3 -- --dry-run     (xem docs/DEPLOY.md, mục "Lưu tệp trên S3/MinIO")
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
MAX_FILE_SIZE_MB=25
# S3_ENDPOINT là URL của API S3 (http:// được phép, không cần SSL), dạng http://<host>:<cổng API S3>.
# MinIO tách HAI cổng: một cổng là API S3, cổng kia là trang quản trị (console) — cổng nào là cổng nào TUỲ CÀI ĐẶT (mặc định MinIO
# là 9000 = API, 9001 = console, nhưng có nơi đặt ngược lại, vd MinIO công ty). Không chắc thì thử HeadBucket để xác định cổng API.
# Bucket phải TẠO SẴN thủ công (riêng cho Tirapro, vd "tirapro"); ứng dụng KHÔNG tự tạo. Khoá bí mật không bao giờ được log.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# MinIO cần path-style (host/bucket/key); đặt false chỉ khi dùng AWS S3 thật theo virtual-host.
S3_FORCE_PATH_STYLE=true
# Khởi động chặt: lỗi cấu hình S3 dứt khoát (bucket không tồn tại, 403/AccessDenied, sai khoá) ⇒ API dừng ngay với thông báo rõ.
# Mặc định: true khi NODE_ENV=production, false còn lại. Lỗi mạng/timeout KHÔNG làm API dừng (thử lại HeadBucket mỗi 30 giây).
# Đặt false chỉ khi cần chữa cháy (API vẫn lên nhưng upload/tải tệp sẽ lỗi).
# STORAGE_STARTUP_STRICT=

# ---------- AI: Anthropic Claude (thiếu key -> degrade gracefully) ----------
ANTHROPIC_API_KEY=
AI_FEATURES_ENABLED=true
AI_MODEL_PRIMARY=claude-opus-4-8
AI_MODEL_FAST=claude-haiku-4-5
AI_MONTHLY_TOKEN_QUOTA_PER_WORKSPACE=5000000

# ---------- AI: Embeddings (Anthropic KHÔNG có embedding API) ----------
EMBEDDING_PROVIDER=none
EMBEDDING_DIM=1024
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
OPENAI_API_KEY=
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small

# ---------- Email (outbox + cron gửi mỗi 30s) ----------
# console = ghi thư ra log API, KHÔNG gửi thật (dev). smtp = khung, chưa gửi được ở bản này.
# Production dùng console thì log API sẽ chứa liên kết đặt lại mật khẩu — chỉ dùng tạm khi chưa có SMTP.
MAIL_DRIVER=console
MAIL_FROM="Tirapro <no-reply@tirapro.local>"
# Gốc URL của web, dùng dựng liên kết trong thư (/reset-password?token=…).
APP_WEB_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---------- Rate limiting (@nestjs/throttler qua Redis) ----------
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ---------- Integrations ----------
# Bot Telegram toàn cục (optional). Để trống nếu mỗi workspace tự dùng bot riêng (BYO).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_DOMAIN=
# Khóa mã hóa secret tích hợp (AES-256-GCM), tối thiểu 32 ký tự.
INTEGRATION_ENCRYPTION_KEY=dev_integration_encryption_key_change_me_0001
# (Tùy chọn) Khoá CŨ — đặt khi vừa đổi INTEGRATION_ENCRYPTION_KEY (vd nâng cấp từ khoá mặc định lên khoá riêng ở production)
# để token Telegram đã mã hoá trước đó vẫn giải được. Sau khi chạy `pnpm --filter @tirapro/api run integrations:rekey` có thể bỏ.
INTEGRATION_ENCRYPTION_KEY_PREVIOUS=

# ---------- Automation ----------
# Webhook của quy tắc tự động mặc định CHẶN địa chỉ nội bộ (127.x, 10.x, 192.168.x…). Chỉ đặt true ở dev/CI.
AUTOMATION_WEBHOOK_ALLOW_PRIVATE=false

# ---------- Web (Vite — chỉ biến VITE_* lộ ra client, KHÔNG đặt secret) ----------
VITE_API_URL=http://localhost:4000/api/v1
VITE_WS_URL=http://localhost:4000
VITE_APP_NAME=Tirapro
VITE_ENABLE_PWA=true
# VITE_SHOW_DEMO_ACCOUNTS=true  # staging/demo: hiện khối "Tài khoản demo" ở trang đăng nhập (production: bỏ trống; dev luôn hiện)
# VITE_FEATURE_REPOS=1  # bật lại mục Kho mã (GitHub/GitLab) + khối "Liên kết code" trên công việc (đang ẩn)
