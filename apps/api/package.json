{
  "name": "@tirapro/api",
  "version": "0.1.0",
  "private": true,
  "description": "Tirapro API (NestJS)",
  "scripts": {
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "build": "nest build",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:parity": "vitest run --config vitest.int.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:raw": "prisma db execute --file ./prisma/sql/01_pgvector_fts.sql --schema ./prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:init": "node prisma/seed-if-empty.mjs",
    "db:seed:rich": "node prisma/seed-rich.mjs",
    "db:seed:roles": "node scripts/seed-system-roles.mjs",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "db:check-roles": "node scripts/check-system-roles.mjs",
    "integrations:rekey": "node scripts/rekey-integrations.mjs",
    "automation:seal-secrets": "node scripts/seal-webhook-secrets.mjs",
    "storage:migrate-local-to-s3": "node scripts/storage-migrate-local-to-s3.mjs",
    "attachments:fix-filenames": "node scripts/attachments-fix-filenames.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@aws-sdk/client-s3": "3.1156.0",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/event-emitter": "^2.1.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/throttler": "^6.3.0",
    "@nestjs/websockets": "^10.4.15",
    "@paralleldrive/cuid2": "^2.2.2",
    "@prisma/client": "^6.1.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@tirapro/shared": "workspace:*",
    "@tirapro/types": "workspace:*",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "cron-parser": "^5.10.2",
    "csv-parse": "^5.6.0",
    "exceljs": "4.4.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "nestjs-pino": "^4.1.0",
    "pino-http": "^10.3.0",
    "prisma": "^6.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "telegraf": "^4.16.3",
    "undici": "^7.30.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@swc/core": "^1.16.18",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "unplugin-swc": "^1.6.0",
    "vitest": "^3.2.7"
  }
}
