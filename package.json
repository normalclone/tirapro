{
  "name": "tirapro",
  "version": "0.1.0",
  "private": true,
  "description": "Tirapro — Jira clone + nâng cấp (NestJS + React + AI + Realtime)",
  "packageManager": "pnpm@10.21.0",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "gen:enums": "node scripts/gen-enums.mjs",
    "knip": "knip",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "eslint . --max-warnings 275",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "docker:up": "docker compose up -d postgres redis",
    "docker:up:tools": "docker compose --profile tools up -d",
    "docker:down": "docker compose down",
    "db:generate": "pnpm --filter @tirapro/api db:generate",
    "db:migrate": "pnpm --filter @tirapro/api db:migrate",
    "db:migrate:deploy": "pnpm --filter @tirapro/api db:migrate:deploy",
    "db:seed": "pnpm --filter @tirapro/api db:seed",
    "db:reset": "pnpm --filter @tirapro/api db:reset",
    "db:studio": "pnpm --filter @tirapro/api db:studio",
    "setup": "pnpm install && pnpm docker:up && pnpm --filter @tirapro/types build && pnpm --filter @tirapro/shared build && pnpm db:migrate && pnpm --filter @tirapro/api db:raw && pnpm db:seed",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.7"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "@scarf/scarf",
      "@swc/core",
      "argon2",
      "esbuild",
      "msgpackr-extract",
      "prisma"
    ]
  }
}
